# --- secrets and local state: never commit ------------------------------
.env
*.env
!*.env.example
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
*.log.*
.credentials*

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- build output (regenerated by build_all.bat) ---------------------------
build/
dist/
shopsystem/build_src/
# PyInstaller writes these on every build, with absolute paths
*.spec

# --- downloaded tools / wheels (large binaries) ----------------------------
shopadmin/.wheels/
shopadmin/.tools/

# --- temporary test folders ------------------------------------------------
.installtest/
.keyringtest/
.pytest_tmp/

# --- customer payment receipts (personal data) -----------------------------
receipts/

# --- runtime data that must never reach git -------------------------------
# Telethon / Telegram user sessions (full account access)
*.session
*.session-journal
*.session.dpapi
# server TLS private key / certificates, any key material
tls/
*.key
*.pem
*.pfx
*.p12
# backups (daily zips, encrypted off-site copies)
backups/
*.zip
*.zip.partial
*.enc
# price lists downloaded from the distributor channel at runtime
pricelists/
# Sazeh DB snapshots (research_tools) may hold real rows
snapshots/

# --- OS / editor ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# build_exe.bat rescue folder (holds .env during a rebuild)
.rebuild_keep/
shopapi/scripts/live_db_check.out.txt

# pytest temp folders created with a basetemp inside a project
pytest-of-*/
# shoptg server package (built by shoptg/build_package.ps1)
shoptg/wheels/
shoptg/vendor/

# v2.6.2: fallback pytest temp of build_all.bat
.buildtmp/

# Local Claude worktrees and sample/customer files
.claude/
samples/
