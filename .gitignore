# --- secrets and local state: never commit ------------------------------
.env
*.env
!*.env.example
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
*.log.*
.credentials*

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- build output (regenerated by build_all.bat) ---------------------------
build/
dist/
shopsystem/build_src/
# PyInstaller writes these on every build, with absolute paths
*.spec

# --- downloaded tools / wheels (large binaries) ----------------------------
shopadmin/.wheels/
shopadmin/.tools/

# --- temporary test folders ------------------------------------------------
.installtest/
.keyringtest/

# --- OS / editor ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# build_exe.bat rescue folder (holds .env during a rebuild)
.rebuild_keep/
