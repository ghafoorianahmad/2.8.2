# =====================================================================
# ShopAdmin — sample configuration
#
# Copy this file to ".env" next to ShopAdmin.exe (or leave it out and use
# the first-run wizard). Values here are only defaults: anything you enter
# in the program's "تنظیمات" page is stored in the local SQLite database and
# takes effect immediately.
#
# NEVER commit a real .env: it contains the shopapi admin key.
# =====================================================================

# Address of the shopapi service.
# It must be reachable from this computer, e.g. on the same machine:
SHOPADMIN_BASE_URL=http://127.0.0.1:8000

# The ADMIN_API_KEY from shopapi's own .env file.
# Required for every customer/order endpoint this program uses.
SHOPADMIN_API_KEY=<<PUT_THE_ADMIN_API_KEY_HERE>>

# How often pages reload data from shopapi, in seconds. 0 disables auto refresh.
SHOPADMIN_AUTO_REFRESH_SECONDS=30

# Log the user out after this many minutes without activity.
SHOPADMIN_SESSION_TIMEOUT_MINUTES=30

# Where the local SQLite file and app.log are written.
# Leave empty for the default: %LOCALAPPDATA%\ShopAdmin
# SHOPADMIN_DATA_DIR=

# ---------------------------------------------------------------------
# Note: this program never connects to SQL Server and never reads or writes
# shopapi's own SQLite file. It only talks HTTP to the address above.
# ---------------------------------------------------------------------
