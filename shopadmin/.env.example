# =====================================================================
# ShopAdmin — sample configuration (optional)
#
# Copy this file to ".env" next to ShopAdmin.exe to pre-set the server
# address on a computer (or simply use the first-run wizard).
#
# There is NO secret in here: every staff member signs in with their own
# username and password, which are checked by the shop server.
# =====================================================================

# Address of the shop server on the network.
SHOPADMIN_BASE_URL=http://192.168.1.10:8000

# How often pages reload data from the server, in seconds. 0 disables it.
SHOPADMIN_AUTO_REFRESH_SECONDS=30

# Lock the program after this many minutes without activity.
SHOPADMIN_SESSION_TIMEOUT_MINUTES=30

# Where the local SQLite file and app.log are written.
# Leave empty for the default: %LOCALAPPDATA%\ShopAdmin
# SHOPADMIN_DATA_DIR=

# ---------------------------------------------------------------------
# This program never connects to SQL Server and never reads or writes the
# server's own database. It only talks HTTP to the address above.
# ---------------------------------------------------------------------
