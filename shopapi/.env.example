# =====================================================================
# shopapi configuration (copy to .env and fill in real values)
# NEVER commit a real .env. No real credentials belong in this repo.
# =====================================================================

# ---- Accounting (SQL Server) connection ------------------------------
# Dev: Windows auth against a local Express instance (read-only copy).
ACCOUNTING_DRIVER=ODBC Driver 17 for SQL Server
ACCOUNTING_SERVER=.\SQLEXPRESS
# The database name may contain spaces; the code quotes it as [hesab5 t].
ACCOUNTING_DATABASE=hesab5 t
ACCOUNTING_TRUSTED_CONNECTION=yes
# Production uses a SQL login (set trusted=no and fill these):
# ACCOUNTING_DRIVER=SQL Server Native Client 10.0
# ACCOUNTING_TRUSTED_CONNECTION=no
# ACCOUNTING_USERNAME=shopbot
# ACCOUNTING_PASSWORD=<<SET_STRONG_PASSWORD>>
ACCOUNTING_ENCRYPT=no
ACCOUNTING_TRUST_SERVER_CERTIFICATE=yes
# Login timeout (seconds) for accounting DB connections.
ACCOUNTING_CONNECT_TIMEOUT=5
# Query timeout (seconds) applied to accounting DB queries.
ACCOUNTING_QUERY_TIMEOUT=15

# ---- Writer safety ---------------------------------------------------
# Real writes are OFF by default: the writer runs the full transaction and
# ROLLS BACK, returning what it would have written.
ACCOUNTING_WRITE_ENABLED=false
# v2.8.1: no database name is built in. The server setup on the server computer
# («تنظیمات سرور») keeps the allowed list and switches real writing on per
# database (with a warning). Empty = no real writes anywhere. A dry run never
# sends an INSERT. (Older rule, still honoured: the switch above + an allowed
# host + the database on the allowed list. ACCOUNTING_TEST_DATABASES: listed
# test copies write without any switch; empty by default.)
ACCOUNTING_ALLOWED_DATABASES=
ACCOUNTING_WRITE_DATABASES=
ACCOUNTING_TEST_DATABASES=
# Host names (SQL Server names) allowed to receive real writes.
ACCOUNTING_ALLOWED_HOSTS=localhost,.\SQLEXPRESS

# ---- Accounting config values ---------------------------------------
# KalaOrder.Status of our orders (a whole number above zero). Deliberately EMPTY:
# each database has its own code; on the production server «تایید» = 6808.
# While empty (or 0), nothing is ever written to accounting (v2.17.0).
ACCOUNTING_STATUS_CODE=
# Optional, read only to show the stage of an order: «تحویل به فروش» (production: 6914).
ACCOUNTING_HANDOVER_STATUS_CODE=
ACCOUNTING_USERCODE=1
ACCOUNTING_ANBARCODE=1
# Comma-separated warehouse codes for stock; empty = all warehouses.
STOCK_WAREHOUSES=

# ---- Business ---------------------------------------------------------
# Price level 1 = Kala.Gey. In the dev copy only level 1 has a full catalogue
# (557 products); levels 2-5 hold 1-2 products, so use 1 for testing.
PRICE_LEVEL_BOT=1
PRICE_LEVEL_SITE=1
# Receipt: the customer uploads it right after ordering (no payment gateway).
# No receipt within this many minutes = the order is cancelled on the shop
# server only (nothing is ever deleted in the accounting DB).
RECEIPT_DEADLINE_MINUTES=30
# v2.8.0: a phone is ordered only while its product has stock in Sazeh; without
# stock (or an unmapped price-list row) the bot offers «درخواست خرید» instead.
PHONE_STOCK_REQUIRED=true
# Sales windows (Iran time): a list posted before 13:30 opens sales until 13:30,
# one posted before 20:30 until 20:30; otherwise / Fridays sales are closed.
# ShopAdmin's buttons (holiday / close / open) override this.
SALES_WINDOWS_ENABLED=true
SALES_MORNING_CLOSE=13:30
SALES_EVENING_CLOSE=20:30
# Python weekday numbers without sales (4 = Friday).
SALES_CLOSED_WEEKDAYS=4
# v2.8.2: no fixed payment details any more (BANK_ACCOUNT_TEXT, PAYMENT_CARD_NUMBER,
# PAYMENT_SHEBA, PAYMENT_OWNER are ignored): staff type the card / account / Sheba /
# holder / bank / note for each order in ShopAdmin («ارسال اطلاعات پرداخت») and the
# bot sends them; the receipt deadline starts then.
# Maximum quantity per line item in a single order.
MAX_ORDER_QTY=10000
# Allow two customers to share one accounting person code (default: no).
ALLOW_SHARED_PERSON_CODE=false
# Customers awaiting approval (mobile not found in accounting) may still order,
# up to this many items counted over all their open orders (0 = may not order).
# There is no amount cap (prices fluctuate). All amounts are in Rial.
PENDING_MAX_ORDER_ITEMS=3
# Receipt images (JPEG/PNG) up to this size; stored in RECEIPTS_DIR
# (empty = a "receipts" folder next to the SQLite file).
RECEIPT_MAX_BYTES=5242880
RECEIPTS_DIR=
# Seconds between checks of written orders for invoices (0 = off).
INVOICE_SYNC_SECONDS=300

# ---- Health monitoring (REQUIREMENTS §8) --------------------------------
# SQL, Bale bot, Bale reachability, Telegram worker; Bale alert + ShopAdmin tray.
HEALTH_CHECK_SECONDS=60
HEALTH_FAIL_THRESHOLD=2
TG_STATUS_STALE_MINUTES=20

# ---- Site catalog models (REQUIREMENTS §9a) ------------------------------
# Server-local hour of the nightly mapping check (-1 = off).
MODEL_CHECK_HOUR=2
# A renamed product stays visible ("drifted", no alert) at or above this name
# similarity; below it (or product gone) the model is hidden + Bale alert.
MODEL_DRIFT_MIN_SCORE=0.7
# The bot accepts a fuzzy model-name match at or above this similarity.
MODEL_RESOLVE_MIN_SCORE=0.75

# ---- Distributor price list (phones; REQUIREMENTS §4-5) ----------------
# PDF prices are thousand Toman -> Rial; empty روال = نقد + 5,000,000 Rial.
PRICELIST_UNIT_RIAL=10000
PRICELIST_CASH_SURCHARGE_RIAL=5000000
# A mapped price moving more than this % holds the new list for review.
PRICELIST_MAX_CHANGE_PCT=15
# Phone prices older than this are not sold (inquiry only); 0 = no limit.
PRICELIST_MAX_AGE_HOURS=72
PRICELISTS_DIR=

# ---- API keys (set strong values in .env) -----------------------------
BOT_API_KEY=
SITE_API_KEY=
ADMIN_API_KEY=
# Telegram price/proxy worker (shoptg): /worker/* only, from this machine only.
WORKER_API_KEY=
# BOT/ADMIN keys are accepted only from this machine (bots run in-process).
# Staff on the LAN sign in with a username/password instead. Keep true.
SERVICE_KEYS_LOCAL_ONLY=true

# ---- Staff sign-in (ShopAdmin clients) ---------------------------------
STAFF_SESSION_HOURS=12
STAFF_REMEMBER_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Own database (SQLite) --------------------------------------------
SQLITE_PATH=shopapi.db
