# =====================================================================
# shopbots configuration. Copy to .env and fill in real values.
# NEVER commit a real .env. Tokens are never printed or logged.
# =====================================================================

# ---- shopapi (the REST API the bots talk to) -------------------------
SHOPAPI_BASE_URL=http://127.0.0.1:8000
# Key sent as X-API-Key for customer calls (role "bot").
BOT_API_KEY=
# Key sent as X-API-Key for admin calls.
ADMIN_API_KEY=

# ---- Bot tokens (from BotFather / Bale's BotFather) -------------------
BALE_TOKEN=

# ---- Telegram bot channel (Phase 7; optional) -------------------------
# Telethon bot login through the MTProto proxy pool. Same Telegram app and proxy
# settings as shoptg - only the bot token is new. All empty = channel off.
TELEGRAM_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
# Reads/reports the proxy pool in shopapi (same key as shoptg).
WORKER_API_KEY=
# Optional known-good proxies (tg://proxy links) tried after the pool; direct last.
TG_PROXY=
TG_ALLOW_DIRECT=true
# Telethon session of the bot (keeps update state across restarts; default
# <folder of SQLITE_PATH>/tg_bot.session). Treat it like a secret.
TG_BOT_SESSION=
TG_HEALTH_INTERVAL_SEC=180
TG_CONNECT_TIMEOUT_SEC=20

# ---- Bot API base URLs (configurable) --------------------------------
# Bale: verify against Bale's official docs with a real test bot.
BALE_API_BASE=https://tapi.bale.ai

# ---- Admins (comma separated chat ids). Admin actions are refused -----
# ---- for any chat id not listed here. --------------------------------
ADMIN_CHAT_IDS=

# ---- Behaviour --------------------------------------------------------
SQLITE_PATH=shopbots.db
POLL_TIMEOUT=25
ADMIN_SWEEP_SECONDS=30
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CALLBACKS=120
MAX_INPUT_LEN=500
MAX_NAME_LEN=80
HTTP_TIMEOUT=15
PRODUCT_PAGE_SIZE=5
# Editable texts/buttons/shop info. Empty = built-in app/messages.fa.json.
# ShopServer uses %ProgramData%\ShopServer\messages.fa.json automatically.
BOT_MESSAGES_FILE=

# Branded image cards (price / pre-invoice / invoice) sent as photos. Off by default;
# any rendering or upload failure falls back to the normal text message.
# Cards are HTML screenshotted by headless Microsoft Edge/Chromium (no download).
# BOT_CARD_BROWSER overrides the browser path (auto-detected otherwise).
BOT_IMAGE_CARDS=false
BOT_CARD_BROWSER=
