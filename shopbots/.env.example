# =====================================================================
# shopbots configuration. Copy to .env and fill in real values.
# NEVER commit a real .env. Tokens are never printed or logged.
# =====================================================================

# ---- shopapi (the REST API the bots talk to) -------------------------
SHOPAPI_BASE_URL=http://127.0.0.1:8000
# Key sent as X-API-Key for customer calls (role "bot").
BOT_API_KEY=
# Key sent as X-API-Key for admin calls.
ADMIN_API_KEY=

# ---- Bot tokens (from BotFather / Bale's BotFather) -------------------
BALE_TOKEN=
TELEGRAM_TOKEN=

# ---- Bot API base URLs (configurable) --------------------------------
# Bale: verify against Bale's official docs with a real test bot.
BALE_API_BASE=https://tapi.bale.ai
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Proxy (Telegram only; Telegram is blocked in Iran) --------------
# e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:8080 . Empty = no proxy.
PROXY_URL=

# ---- Admins (comma separated chat ids). Admin actions are refused -----
# ---- for any chat id not listed here. --------------------------------
ADMIN_CHAT_IDS=

# ---- Behaviour --------------------------------------------------------
SQLITE_PATH=shopbots.db
POLL_TIMEOUT=25
ADMIN_SWEEP_SECONDS=30
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60
MAX_INPUT_LEN=500
MAX_NAME_LEN=80
HTTP_TIMEOUT=15
PRODUCT_PAGE_SIZE=5
