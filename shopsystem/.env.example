# =====================================================================
#  ShopSystem configuration
#
#  Normally written by the server setup in ShopAdmin. By hand:
#  1. copy this file to  %ProgramData%\ShopServer\.env
#     (or next to ShopSystem.exe for an old portable copy)
#  2. fill in your own tokens, API keys and database details
#  3. restrict that folder to Administrators and SYSTEM
#
#  Save the file as UTF-8. Never share it: it contains your secrets.
#  ASCII-only on purpose so Notepad on any Windows shows it correctly.
# =====================================================================

# ---- Bale bot (from Bale's BotFather) -------------------------------
BALE_TOKEN=

# ---- the API this program serves ------------------------------------
# API_HOST=0.0.0.0 lets the staff computers on the LAN connect.
# API_TLS=true serves HTTPS with this server's own certificate (made on
# first start in the tls folder); ShopAdmin pins it during setup.
API_HOST=127.0.0.1
API_PORT=8000
API_TLS=true

# ---- API keys --------------------------------------------------------
# Long random strings. BOT/ADMIN are used only inside this server (the bots)
# and are refused from the network. Staff sign in with their own accounts.
BOT_API_KEY=
SITE_API_KEY=
ADMIN_API_KEY=
SERVICE_KEYS_LOCAL_ONLY=true

# ---- staff sign-in (ShopAdmin) ---------------------------------------
STAFF_SESSION_HOURS=12
STAFF_REMEMBER_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- admin chat ids -------------------------------------------------
# Comma separated Bale chat ids, e.g.   bale:987654321
# A bare number matches any platform.
ADMIN_CHAT_IDS=

# Bot texts / buttons / shop info: messages.fa.json in this same folder
# (created on first start; edit it, then restart the ShopServer task).

# ---- accounting database (Sazeh Hesab, SQL Server) ------------------
DB_SERVER=.\SQLEXPRESS
DB_NAME=hesab5 t
DB_DRIVER=ODBC Driver 17 for SQL Server
# yes = Windows authentication, no = SQL login (then fill DB_USER/DB_PASSWORD)
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no

# =====================================================================
#  SAFETY: keep this false until you are ready for REAL writes.
#  false = the writer runs the whole transaction and rolls it back.
# =====================================================================
ACCOUNTING_WRITE_ENABLED=false

# ---- business settings ----------------------------------------------
# Price level 1 = Kala.Gey, 2 = Geycf, 3 = gey3, 4 = gey4, 5 = gey5
# Accessories are sold at level 3 (REQUIREMENTS §4).
PRICE_LEVEL_BOT=3
PRICE_LEVEL_SITE=3
RESERVE_HOURS=12
# Text shown to the customer after checkout (Persian is fine, save as UTF-8)
BANK_ACCOUNT_TEXT=
MAX_ORDER_QTY=10000
ALLOW_SHARED_PERSON_CODE=false
# Customers awaiting approval (mobile not found in accounting) may still order,
# up to this many items counted over all their open orders (0 = may not order).
# There is no amount cap (prices fluctuate). All amounts are in Rial.
PENDING_MAX_ORDER_ITEMS=3
# Receipt images (JPEG/PNG) up to this size; stored in RECEIPTS_DIR
# (empty = a "receipts" folder next to the SQLite file).
RECEIPT_MAX_BYTES=5242880
RECEIPTS_DIR=
# Seconds between checks of written orders for invoices (0 = off).
INVOICE_SYNC_SECONDS=300

# ---- accounting constants (leave as-is unless told otherwise) -------
# 0 = "no status"; 6808 does not exist. Confirm with GUI test G2 before production.
ACCOUNTING_STATUS_CODE=0
ACCOUNTING_USERCODE=1
ACCOUNTING_ANBARCODE=1
STOCK_WAREHOUSES=

# ---- logging: INFO, DEBUG, WARNING ----------------------------------
LOG_LEVEL=INFO
