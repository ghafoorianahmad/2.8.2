# =====================================================================
# shoptg - Telegram price/proxy worker. Copy to .env (install.ps1 does it).
# NEVER commit or share the real .env. Values are never printed or logged.
# Edit it from an elevated PowerShell:  notepad .env
# =====================================================================

# ---- Telegram application (my.telegram.org > API development tools, ----
# ---- logged in as the SHOP's Telegram account) ----------------------
TG_API_ID=
TG_API_HASH=

# ---- Channels -------------------------------------------------------
# Distributor price list (public channel; read only, never joined).
TG_PRICE_CHANNEL=AbrishamiiPhoneMashhad
# Proxy channels the shop account follows (comma separated usernames).
TG_PROXY_CHANNELS=

# ---- Proxies --------------------------------------------------------
# Known-good MTProto proxy link(s) on this server, space/comma separated:
#   tg://proxy?server=...&port=...&secret=...   (ee / dd / plain secrets)
# Used by login/check and as the worker's fallback after the shopapi pool.
TG_PROXY=
# Try a direct connection when every proxy failed.
TG_ALLOW_DIRECT=true

# ---- Storage --------------------------------------------------------
# Encrypted session + log. Default: %ProgramData%\ShopServer\shoptg
TG_DATA_DIR=
# Phase 4: the Windows service account that may READ the session file.
TG_SERVICE_ACCOUNT=

# ---- shopapi (not needed for login.ps1 / check_pricelist.ps1) -------
SHOPAPI_BASE_URL=http://127.0.0.1:8000
SHOPAPI_CA_FILE=
# Same value as WORKER_API_KEY in shopapi's .env.
WORKER_API_KEY=

# ---- Timing ---------------------------------------------------------
TG_PRICE_INTERVAL_MIN=30
TG_PROXY_COLLECT_DAYS=7
TG_HEALTH_INTERVAL_SEC=180
TG_PROBE_INTERVAL_MIN=60
TG_PROBE_MAX=15
TG_CONNECT_TIMEOUT_SEC=20
TG_UNREACHABLE_ALERT_MIN=15
